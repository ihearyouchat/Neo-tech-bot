# Get this from @BotFather on Telegram (see README)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get this from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the model
CLAUDE_MODEL=claude-sonnet-5

# Get this from assemblyai.com — key appears on your dashboard right after
# signup, no separate creation step. Used to transcribe voice messages.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Optional: override the transcription language (default "en")
ASSEMBLYAI_LANGUAGE_CODE=en
